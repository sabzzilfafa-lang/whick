# Whick SSD partition SSOT
# root(OS + Docker + runtime + Ollama/Gemma4:e2b) 예약 — 이원화 고정값 (disk_plan.py install_reserve_gb)
# 128GB 미만(64GB eMMC 포함): 32GB root / 128GB 이상: 64GB root — 나머지 전부 /mnt/music
# 향후 시스템 업데이트로 root가 부족해도 파티션을 다시 나눌 수 없어 처음부터 이원화로 여유를 둔다.
# WHICK_INSTALL_RESERVE_GB를 여기서 값으로 지정하면 이원화를 무시하고 그 값을 강제하므로 비워둔다.
# 128 대신 112 — lsblk 크기는 GiB(1024^3) 기준이라 "128GB"급 실제 디스크는 ~119GiB로
# 보이므로, 128GB급이 32GB tier로 잘못 분류되지 않게 여유를 둔 값.
WHICK_ROOT_TIER_THRESHOLD_GB=112
WHICK_ROOT_SMALL_GB=32
WHICK_ROOT_LARGE_GB=64
WHICK_MUSIC_LABEL=whick-music
WHICK_ROOT_LABEL=whick-root
WHICK_MUSIC_MOUNT=/mnt/music
WHICK_EFI_SIZE_MIB=512
# Minimum music partition when disk is small (64GB eMMC: 32GB system + ~23GB music)
WHICK_MUSIC_MIN_GB=15
# Minimum root when disk is too small even for the small tier (lab loopback 등)
WHICK_INSTALL_MIN_GB=32
# Rescue partition — REMOVED from design (2026-07-26). Keep 0 forever.
# Full OS reinstall = USB Live only. Do not set to 1.
WHICK_RESCUE_ENABLE=0
WHICK_RESCUE_GB=3
WHICK_RESCUE_LABEL=whick-rescue
