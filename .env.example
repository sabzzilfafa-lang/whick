# Whick customer runtime — copy to .env (never commit secrets)
WHICK_DEVICE_SERIAL=
# UAB install/register-product hw_id_hash (64hex). install-credentials.json 있으면 생략 가능
WHICK_OWNER_MB_ID=
WHICK_CC_API_URL=https://admin.whick.org/api/v1
# 본사 서버 내부(루프백) 테스트만: http://127.0.0.1:8090/api/v1
# WHICK_INSTALL_CREDENTIALS_PATH=/var/lib/whick/install-credentials.json
# WHICK_AGENT_TOKEN=   # optional — agent가 /agent/register 후 runtime-state.json에 저장
WHICK_ENV=dev
WHICK_SOFTWARE_VERSION=v0.1.0-dev
WHICK_SOLUTION_CODE=S2

# agent
WHICK_AGENT_POLL_MS=5000
WHICK_STATE_PATH=/var/lib/whick/runtime-state.json
WHICK_AUDIO_URL=http://whick-audio:8787

# monitor (관제담당 — agent register 후 runtime-state token 사용)
WHICK_MONITOR_INTERVAL_SEC=30
WHICK_MONITOR_TOKEN_WAIT_MS=120000
WHICK_LIBRARY_INCOMING=/var/lib/whick/library/incoming
WHICK_COMPOSE_PROJECT=whick-runtime

# audio stub
WHICK_AUDIO_PORT=8787
WHICK_AUDIO_DEFAULT_VOLUME=70
WHICK_AUDIO_DEVICE=default

# optional paths
WHICK_LIBRARY_PATH=/var/lib/whick/library

# player (리모컨 API · MPD · PostgreSQL)
WHICK_PLAYER_DB_PASSWORD=whick_player_dev
# 중앙 서버 SSOT: localhost · 고객 미니PC LAN은 WHICK_PLAYER_PORT_BIND=0.0.0.0:8080 (compose.override)
WHICK_PLAYER_PORT_BIND=127.0.0.1:8080
# http://IP/ (포트 생략) → player. 고객 LAN: 0.0.0.0:80
WHICK_PLAYER_PORT80_BIND=127.0.0.1:80
# 1=Spotify·Tidal 스트리밍 연동 (설정 탭). 고객은 유료 계정 인증만 진행한다.
WHICK_PLAYER_EXTERNAL_PROVIDERS=1
# 1=토큰 없이 lab mock (개발·CI). 집 실테스트는 0
WHICK_STREAMING_LAB=0
# 시스템 운영자용 선택 설정: Spotify Web API 검색/제어 PKCE. 고객 입력값 아님.
# WHICK_SPOTIFY_CLIENT_ID=
# Redirect = http://<미니PC-IP>:8080/api/streaming/spotify/oauth/callback
# WHICK_SPOTIFY_REDIRECT_URI=http://192.168.0.10:8080/api/streaming/spotify/oauth/callback
# 시스템 운영자용 설정: Tidal device flow client. 고객 입력값 아님.
# WHICK_TIDAL_CLIENT_ID=
# WHICK_TIDAL_COUNTRY_CODE=US
# MPD·Tidal → CamillaDSP (1=활성)
# WHICK_CAMILLA_ENABLED=1
# 실 DAC (미니PC ALSA). Docker lab은 비워두면 null sink
# WHICK_CAMILLA_ALSA_DEVICE=default
# Spotify Connect(librespot) 자동 시작 — 고객 유료 계정 연결 대기
WHICK_LIBRESPOT_AUTOSTART=1
# 1=리모컨 Bearer device_token 필수 (WHICK_PLAYER_DEVICE_TOKEN 또는 /var/lib/whick/remote-device-token)
# 외부·LTE 터널 노출 시 반드시 1. install-runtime 이 CC remote_device_token 을 주입한다.
WHICK_PLAYER_AUTH_REQUIRED=0
# CC remote_device_token (SSOT) — 리모컨이 CC 에서 받는 player_token 과 동일해야 인증 통과
# WHICK_PLAYER_DEVICE_TOKEN=devtok_...
# 외부·LTE named tunnel (cloudflared). 프로비저닝 번들 존재 시 install-runtime 이
# ./tunnel/ 배포 + compose.tunnel.override.yaml 자동 생성(별도 env 불필요).
# 고객 음원: 설치 후 /mnt/music/whick-data (install-runtime bind). 개발·랩은 named volume.
WHICK_LIBRARY_SCAN_PATHS=/var/lib/whick/library/music
WHICK_EXTERNAL_AUTO_MODE=1
WHICK_PLAYER_CORS=*
WHICK_RUNTIME_SERVICES=agent,audio,player,monitor

# network_test 보수화 — 일부 USB NIC는 회선 포화 시 wedge되어 power cycle이 필요해진다.
# 정확도보다 회선 안정성을 우선. 더 줄이려면 값을 낮춘다(재빌드 불필요, agent 재시작만).
WHICK_NET_PARALLEL=1
WHICK_NET_MEASURE_MS=1200
WHICK_NET_UL_CHUNK=1048576
WHICK_NET_DL_CHUNK=4194304
WHICK_NET_MAX_BYTES=50331648
WHICK_NET_PACING_MS=40

# CDN speedtest (기본 WHICK_SPEED_MODE=cdn) — NIA/speedtest급 회선속도, 총 ~9초 이내
WHICK_SPEED_MODE=cdn
WHICK_SPEED_PARALLEL=6
WHICK_SPEED_WARMUP_MS=300
WHICK_SPEED_MEASURE_MS=2000
WHICK_SPEED_DRAIN_MS=800
WHICK_SPEED_GAP_MS=150

# local AI (Ollama sidecar — compose profile local-ai)
WHICK_LOCAL_AI=1
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b
# 0=CPU(기본·내장GPU 모델). 외장 GPU 장착 모델은 install-runtime이 auto+GPU passthrough 자동 설정.
OLLAMA_NUM_GPU=0
# 고객 지역 고정 (GPS 거부·터널 서울 IP 교정). 예: 대구
# WHICK_GEO_LAT=35.8714
# WHICK_GEO_LON=128.6014
# WHICK_GEO_CITY=대구
# WHICK_GEO_REGION=대구광역시
# lab/dev (Whick HQ GPU ollama 재사용): WHICK_REUSE_HOST_OLLAMA=1
# 강제 CPU-only가 필요하면 설치/런타임에서 WHICK_OLLAMA_CPU_ONLY=1 사용.

# WHICK_KMA_SERVICE_KEY=
# WHICK_KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# WHICK_WEATHER_PROVIDER=kma
# 기상청 공공데이터 (VilageFcstInfoService_2.0 초단기실황)
WHICK_KMA_SERVICE_KEY=
WHICK_KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
WHICK_WEATHER_PROVIDER=kma
